# ==============================================================================
# RAD-UniQA Configuration
# ==============================================================================
# IMPORTANT: This is a TEMPLATE file. DO NOT paste real API keys here.
#            Copy this file to a new file named ".env" (no .example suffix)
#            and paste your real API keys in THAT file.
#            The .env file is blocked from Git by .gitignore.
# ==============================================================================

# Select active LLM provider: "auto" | "gemini" | "groq" | "ollama"
# "auto" = smart routing based on question complexity (recommended)
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Recommended — Best Quality)
#    Get your free key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Generation Models (Router picks automatically based on marks & task):
# 10-Mark / Derivations / Diagrams: Gemini 3.7 Flash
GEMINI_MODEL=gemini-3.7-flash

# 2-Mark & 5-Mark Fast Queries: Gemini 3.5 Flash Lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Gemini Embedding 2 — Best Multimodal & Technical Embedding
# Runs on Google's servers (0 server RAM cost, fits any platform)
GEMINI_EMBED_MODEL=gemini-embedding-2

# ------------------------------------------------------------------------------
# 2. GROQ CLOUD (High-Throughput 2nd Fallback — 14.4K RPD Free)
#    Get your free key: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. LOCAL OLLAMA (3rd Offline Fallback — 100% Free & No Internet Needed)
#    Requires Ollama installed: https://ollama.com/
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q5_K_M

# ------------------------------------------------------------------------------
# Embedding Configuration
# ------------------------------------------------------------------------------
# "gemini" = Gemini Embedding 2 via API (best quality, 0 server RAM) [RECOMMENDED]
# "local"  = all-MiniLM-L6-v2 (80MB, works offline, fits all free tiers)
EMBED_PROVIDER=gemini
# Local fallback model (only used when EMBED_PROVIDER=local or Gemini API fails)
EMBED_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
# Use http://localhost:6333 if running Docker, OR leave as-is for local disk mode
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rad_uniqa

# ------------------------------------------------------------------------------
# Chunking & Retrieval Parameters
# ------------------------------------------------------------------------------
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=250
TOP_K_CANDIDATES=20
TOP_K_FINAL=4
